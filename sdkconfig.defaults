# ---- wheel_speed_monitor v1 固化配置 ----
# 分区：v1 无 OTA/SPIFFS，用默认单 app 分区，显式固化防止误选
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# Freenove FNK0085 板载 16MB Flash；仅影响 esptool 校验，v1 固件 <1MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 验证台最多 4 台设备连热点，显式固化
CONFIG_ESP_WIFI_AP_MAX_STA_CONN=4

# WS 每客户端 1 socket + HTTP 并行 + 预留；lwIP 默认 10 在 2+ 客户端时偏紧
CONFIG_LWIP_MAX_SOCKETS=16

# 默认 1000Hz 显式固化：50ms/100ms 周期必须是 1ms tick 整数倍，换 tick 会破坏采样节拍
CONFIG_FREERTOS_HZ=1000

# 默认 -Og 体积偏大，v1 验证台无调试需求，-Os 控 flash
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# WiFi 事件任务栈：默认 2304 在 AP 多客户端事件下偏小，提到 4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# WebSocket 支持（httpd_ws_frame_t 等类型由此门控）
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_STACK_SIZE=8192
